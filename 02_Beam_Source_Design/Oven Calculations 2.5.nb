        RowBox[{"Dynamic", "[", "\n", "    ", 
         RowBox[{"Column", "[", 
          RowBox[{"{", "\n", "      ", 
           RowBox[{
            RowBox[{"\"\<Temperature (K): \>\"", " ", "<>", " ", 
             RowBox[{"ToString", "[", 
              RowBox[{"pt", "[", 
               RowBox[{"[", "1", "]"}], "]"}], "]"}]}], ",", "\n", "      ", 
            RowBox[{"\"\<Pressure (Torr): \>\"", " ", "<>", " ", 
             RowBox[{"ToString", "[", 
              RowBox[{"pt", "[", 
               RowBox[{"[", "2", "]"}], "]"}], "]"}]}], ",", "\n", "      ", 
            RowBox[{"\"\<Mean Free Path (cm): \>\"", " ", "<>", " ", 
             RowBox[{"ToString", "[", 
              RowBox[{
               RowBox[{"meanFreePath", "[", 
                RowBox[{
                 RowBox[{"pt", "[", 
                  RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
                 RowBox[{"pt", "[", 
                  RowBox[{"[", "2", "]"}], "]"}]}], "]"}], "*", "100"}], 
              "]"}]}]}], "\n", "      ", "}"}], "]"}], "\n", "    ", "]"}]}], 
       "\n", "   ", "}"}], "]"}]}], "\n", " ", "]"}], "\n"}]}]], "Code",
