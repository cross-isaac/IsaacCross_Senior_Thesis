Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", "Parameters", " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"ovenTemp", " ", "=", " ", "325"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"ovenPressure", " ", "=", " ", "10"}], ";"}], "\n", "\n", 
   RowBox[{"(*", " ", "Constants", " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"kB", " ", "=", " ", "1.380649*^-23"}], ";"}], " ", 
   RowBox[{"(*", " ", 
    RowBox[{"Boltzmann", " ", "constant", " ", "in", " ", 
     RowBox[{"J", "/", "K"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"\[Zeta]", " ", "=", " ", "3.4*^-10"}], ";"}], "   ", 
   RowBox[{"(*", " ", 
    RowBox[{
    "Diameter", " ", "of", " ", "Argon", " ", "molecule", " ", "in", " ", 
     "meters"}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"torrToPa", " ", "=", " ", "133.322"}], ";"}], " ", 
   RowBox[{"(*", " ", 
    RowBox[{
    "Conversion", " ", "factor", " ", "from", " ", "torr", " ", "to", " ", 
     "Pascals"}], " ", "*)"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"Define", " ", "Function"}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"meanFreePath", "[", 
      RowBox[{"T_", ",", "P_"}], "]"}], ":=", 
     FractionBox[
      RowBox[{"kB", "*", "T"}], 
      RowBox[{
       RowBox[{"Sqrt", "[", "2", "]"}], " ", "Pi", " ", 
       SuperscriptBox["\[Zeta]", "2"], " ", "P", "*", "torrToPa", " "}]]}], 
    ";"}], 
   RowBox[{"(*", "m", "*)"}]}]}]], "Code",
