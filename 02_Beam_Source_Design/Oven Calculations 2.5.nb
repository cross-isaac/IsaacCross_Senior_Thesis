Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Range", " ", "of", " ", "Plot"}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"tempRange", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"273", ",", "500"}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"pressRange", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"1", "/", "100"}], ",", " ", "3"}], "}"}]}], ";"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "Set", " ", "threshold", " ", "for", " ", "mean", " ", "free", " ", 
     "path"}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"threshold", " ", "=", " ", "0.00005"}], ";"}], " ", 
   RowBox[{"(*", " ", 
    RowBox[{"example", " ", "threshold", " ", "in", " ", "meters"}], " ", 
    "*)"}], "\n", "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "Interactive", " ", "Plot", " ", "with", " ", "Logarithmic", " ", 
     "Scaling"}], " ", "*)"}], "\n", 
   RowBox[{"DynamicModule", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"pt", " ", "=", " ", 
       RowBox[{"{", 
        RowBox[{"300", ",", " ", "1"}], "}"}]}], "}"}], ",", "\n", " ", 
     RowBox[{"Column", "[", 
      RowBox[{"{", "\n", "   ", 
       RowBox[{
        RowBox[{"LocatorPane", "[", "\n", "    ", 
         RowBox[{
          RowBox[{"Dynamic", "[", "pt", "]"}], ",", "\n", "    ", 
          RowBox[{"Show", "[", "\n", "     ", 
           RowBox[{
            RowBox[{"DensityPlot", "[", 
             RowBox[{
              RowBox[{"Log10", "[", 
               RowBox[{"meanFreePath", "[", 
                RowBox[{"T", ",", " ", "P"}], "]"}], "]"}], ",", " ", 
              RowBox[{"{", 
               RowBox[{"T", ",", " ", 
                RowBox[{"tempRange", "[", 
                 RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
                RowBox[{"tempRange", "[", 
                 RowBox[{"[", "2", "]"}], "]"}]}], "}"}], ",", " ", 
              RowBox[{"{", 
               RowBox[{"P", ",", " ", 
                RowBox[{"pressRange", "[", 
                 RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
                RowBox[{"pressRange", "[", 
                 RowBox[{"[", "2", "]"}], "]"}]}], "}"}], ",", "\n", "      ", 
              RowBox[{
              "PlotLabel", " ", "->", 
               " ", "\"\<Logarithmic Mean Free Path of Argon\>\""}], ",", 
              "\n", "      ", 
              RowBox[{"AxesLabel", " ", "->", " ", 
               RowBox[{"{", 
                
                RowBox[{"\"\<Temperature (K)\>\"", ",", 
                 " ", "\"\<Pressure (Torr)\>\""}], "}"}]}], ",", "\n", 
              "      ", 
              RowBox[{"ColorFunction", " ", "->", " ", "\"\<Rainbow\>\""}], ",",
               "\n", "      ", 
              RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", "\n", 
              "      ", 
              RowBox[{"ImageSize", " ", "->", " ", "Large"}], ",", "\n", 
              "      ", 
              RowBox[{"Frame", " ", "->", " ", "True"}], ",", "\n", "      ", 
              RowBox[{"FrameLabel", " ", "->", " ", 
               RowBox[{"{", 
                
                RowBox[{"\"\<Temperature (K)\>\"", ",", 
                 " ", "\"\<Pressure (Torr)\>\""}], "}"}]}], ",", "\n", 
              "      ", 
              RowBox[{"PlotLegends", " ", "->", " ", "Automatic"}]}], "]"}], ",",
             "\n", "     ", 
            RowBox[{"ContourPlot", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"Log10", "[", 
                RowBox[{"meanFreePath", "[", 
                 RowBox[{"T", ",", " ", "P"}], "]"}], "]"}], " ", "==", " ", 
               RowBox[{"Log10", "[", "threshold", "]"}]}], ",", " ", 
              RowBox[{"{", 
               RowBox[{"T", ",", " ", 
                RowBox[{"tempRange", "[", 
                 RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
                RowBox[{"tempRange", "[", 
                 RowBox[{"[", "2", "]"}], "]"}]}], "}"}], ",", " ", 
              RowBox[{"{", 
               RowBox[{"P", ",", " ", 
                RowBox[{"pressRange", "[", 
                 RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
                RowBox[{"pressRange", "[", 
                 RowBox[{"[", "2", "]"}], "]"}]}], "}"}], ",", "\n", "      ", 
              RowBox[{"ContourStyle", " ", "->", " ", 
               RowBox[{"{", 
                RowBox[{"Thick", ",", " ", "Black"}], "}"}]}]}], "]"}]}], 
