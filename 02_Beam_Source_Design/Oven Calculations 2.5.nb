Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", "Constants", " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"K", " ", "=", " ", 
     RowBox[{"62.364", "/", "avogadroNumber"}]}], ";"}], " ", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"L", "\[CenterDot]", 
      RowBox[{"Torr", "/", 
       RowBox[{"(", 
        RowBox[{"mol", "\[CenterDot]", "K"}], ")"}]}]}], ",", " ", 
     RowBox[{"ideal", " ", "gas", " ", "constant", " ", "in", " ", "Torr"}]}],
     " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"molarMassArgon", " ", "=", " ", "39.948"}], ";"}], " ", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"g", "/", "mol"}], ",", " ", 
     RowBox[{"molar", " ", "mass", " ", "of", " ", "Argon"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"avogadroNumber", " ", "=", " ", 
     RowBox[{"6.02214076", " ", "*", " ", 
      RowBox[{"10", "^", "23"}]}]}], ";"}], " ", 
   RowBox[{"(*", " ", 
    RowBox[{"atoms", "/", "mol"}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"StoH", " ", "=", " ", 
     SuperscriptBox["60", "2"]}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{"Convert", " ", "seconds", " ", "to", " ", "hours"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"densityArgon20K", " ", "=", " ", "1.768"}], ";"}], " ", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"g", "/", 
      RowBox[{"cm", "^", "3"}]}], ",", " ", 
     RowBox[{
     "density", " ", "of", " ", "solid", " ", "Argon", " ", "at", " ", "20", " ",
       "K"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"radiusInches", " ", "=", " ", "0.2"}], ";"}], " ", 
   RowBox[{"(*", " ", 
    RowBox[{"inches", ",", " ", 
     RowBox[{"radius", " ", "of", " ", "the", " ", "cylinder"}]}], " ", 
    "*)"}], 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Radius", " ", "of", " ", "ID"}], ",", " ", 
     RowBox[{
     "so", " ", "assuming", " ", "this", " ", "forms", " ", "the", " ", 
      "area", " ", "of", " ", "the", " ", "sample"}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"radiusCm", " ", "=", " ", 
     RowBox[{"radiusInches", " ", "*", " ", "2.54"}]}], ";"}], " ", 
   RowBox[{"(*", " ", 
    RowBox[{"cm", ",", " ", 
     RowBox[{
     "conversion", " ", "from", " ", "inches", " ", "to", " ", 
      "centimeters"}]}], " ", "*)"}], "\n", "\n", 
   RowBox[{"(*", 
    RowBox[{"Define", " ", "Function"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"growthRateGpH", "[", 
      RowBox[{
      "N_", ",", "T_", ",", "P_", ",", "D_", ",", "L_", ",", "\[Rho]_"}], 
      "]"}], ":=", 
     RowBox[{"P", "*", 
      FractionBox[
       RowBox[{"viscousConductanceNozzle", "[", 
        RowBox[{"N", ",", "T", ",", 
         RowBox[{"P", "/", "2"}], ",", "D", ",", "L", ",", "\[Rho]"}], "]"}], 
       RowBox[{"K", "*", "T"}]], "*", 
      FractionBox["1", "avogadroNumber"], "*", "molarMassArgon", "*", 
      "StoH"}]}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{"g", "/", "h"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"growthRateHpH", "[", 
      RowBox[{
      "N_", ",", "T_", ",", "P_", ",", "D_", ",", "L_", ",", "\[Rho]_"}], 
      "]"}], ":=", " ", 
     RowBox[{
      FractionBox[
       RowBox[{"growthRateGpH", "[", 
        RowBox[{"N", ",", "T", ",", "P", ",", "D", ",", "L", ",", "\[Rho]"}], 
        "]"}], "densityArgon20K"], "*", 
      FractionBox["1", 
       RowBox[{"Pi", " ", 
        SuperscriptBox["radiusCm", "2"]}]], "*", 
      SuperscriptBox["10", "4"]}]}], ";"}], "\n", "\n", 
   RowBox[{"(*", 
    RowBox[{"molecular", " ", "functions"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"molecularGrowthRateGpH", "[", 
      RowBox[{"N_", ",", "T_", ",", "P_", ",", "D_", ",", "L_"}], "]"}], ":=", 
     RowBox[{"P", "*", 
      FractionBox[
       RowBox[{"molecularConductanceNozzle", "[", 
        RowBox[{"N", ",", "T", ",", "D", ",", "L"}], "]"}], 
       RowBox[{"K", "*", "T"}]], "*", 
      FractionBox["1", "avogadroNumber"], "*", "molarMassArgon", "*", 
      "StoH"}]}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{"g", "/", "h"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"molecularGrowthRateHpH", "[", 
      RowBox[{"N_", ",", "T_", ",", "P_", ",", "D_", ",", "L_"}], "]"}], ":=",
      " ", 
     RowBox[{
      FractionBox[
       RowBox[{"molecularGrowthRateGpH", "[", 
        RowBox[{"N", ",", "T", ",", "P", ",", "D", ",", "L"}], "]"}], 
       "densityArgon20K"], "*", 
      FractionBox["1", 
       RowBox[{"Pi", " ", 
        SuperscriptBox["radiusCm", "2"]}]], "*", 
      SuperscriptBox["10", "4"]}]}], ";"}], "\n", "\n", "\n", 
   RowBox[{"Print", "[", 
    RowBox[{"\"\<Viscous Growth rate at \>\"", ",", " ", "ovenTemp", ",", 
     " ", "\"\< (K) and \>\"", ",", " ", "ovenPressure", ",", 
     " ", "\"\< (torr) and viscous conductance of \>\"", ",", 
     RowBox[{"viscousConductanceNozzle", "[", 
      RowBox[{"numberCapillary", ",", "ovenTemp", ",", 
       RowBox[{"ovenPressure", "/", "2"}], ",", "diameterCapillary", ",", 
       "lengthCapillary", ",", "\[Rho]"}], "]"}], ",", "\"\< is \>\"", ",", 
     " ", 
     RowBox[{"growthRateGpH", "[", 
      RowBox[{
      "numberCapillary", ",", "ovenTemp", ",", "ovenPressure", ",", 
       "diameterCapillary", ",", "lengthCapillary", ",", "\[Rho]"}], "]"}], ",",
      " ", "\"\< (g/hour)\>\""}], "]"}], "\n", 
   RowBox[{"Print", "[", 
    RowBox[{"\"\<Or in \[Mu]m/hour: \>\"", ",", " ", 
     RowBox[{"growthRateHpH", "[", 
      RowBox[{
      "numberCapillary", ",", "ovenTemp", ",", "ovenPressure", ",", 
       "diameterCapillary", ",", "lengthCapillary", ",", "\[Rho]"}], "]"}]}], 
    "]"}], "\n", 
   RowBox[{"Print", "[", "\"\<\>\"", "]"}], "\n", 
   RowBox[{"Print", "[", 
    RowBox[{"\"\<Molecular Growth rate at \>\"", ",", " ", "ovenTemp", ",", 
     " ", "\"\< (K) and \>\"", ",", " ", "ovenPressure", ",", 
     " ", "\"\< (torr) and molecular conductance of \>\"", ",", 
     RowBox[{"molecularConductanceNozzle", "[", 
      RowBox[{
      "numberCapillary", ",", "ovenTemp", ",", "diameterCapillary", ",", 
       "lengthCapillary"}], "]"}], ",", "\"\< is \>\"", ",", " ", 
     RowBox[{"molecularGrowthRateGpH", "[", 
      RowBox[{
      "numberCapillary", ",", "ovenTemp", ",", "ovenPressure", ",", 
       "diameterCapillary", ",", "lengthCapillary"}], "]"}], ",", 
     " ", "\"\< (g/hour)\>\""}], "]"}], "\n", 
   RowBox[{"Print", "[", 
    RowBox[{"\"\<Or in \[Mu]m/hour: \>\"", ",", " ", 
     RowBox[{"molecularGrowthRateHpH", "[", 
      RowBox[{
      "numberCapillary", ",", "ovenTemp", ",", "ovenPressure", ",", 
       "diameterCapillary", ",", "lengthCapillary"}], "]"}]}], 
    "]"}]}]}]], "Code",
