      "1", " ", "mol", " ", "O2", " ", "consumes", " ", "4", " ", "mol", " ", 
       "Rb", "\n", "   ", "So", " ", "O2", " ", "is", " ", "4", "x", " ", 
       "more", " ", "aggressive", " ", "than", " ", "H2O", " ", "per", " ", 
       "mole", " ", "of", " ", "leaked", " ", 
       RowBox[{"gas", "."}]}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"TimeO2Stoich", " ", "=", " ", 
     RowBox[{"UnitConvert", "[", 
      RowBox[{
       RowBox[{"RbMol", " ", "/", " ", 
        RowBox[{"(", 
         RowBox[{"4", " ", "*", " ", "MolarFlow"}], ")"}]}], ",", 
       " ", "\"\<Years\>\""}], "]"}]}], ";"}], "\n", 
   RowBox[{"Print", "[", 
    RowBox[{"\"\<Rb depletion time (O2 stoich, 4 Rb per O2) = \>\"", ",", " ",
      "TimeO2Stoich"}], "]"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"Both", " ", 
     RowBox[{"cases", ":", " ", 
      RowBox[{"hundreds", " ", "to", " ", "thousands", " ", "of", " ", 
       RowBox[{"years", " ", "--"}], " ", "leak", " ", "rate", " ", "is", " ",
        "negligible"}]}]}], " ", "*)"}]}]}]], "Code",
