     RowBox[{
     "\"\<Max tilt angle caused by 10 1.33 flanges with 5/1000 in tolerance: \
\>\"", ",", "MaxTiltAngle", ",", "\"\<\[Degree]\>\""}], "]"}], ";"}], 
   "\[IndentingNewLine]", 
