Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"DisSamp", "=", "16.8"}], ";"}], " "}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"RadTube", " ", "=", ".2"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"RadNozzleFlange", " ", "=", " ", ".75"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"MaxAng", " ", "=", " ", 
   RowBox[{"ArcTan", "[", 
    RowBox[{"DisSamp", "/", "RadTube"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"MaxAngDegrees", " ", "=", " ", 
   RowBox[{"MaxAng", "/", "Degree"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"MaxBeamDivergence", " ", "=", " ", 
   RowBox[{"90", "-", "MaxAngDegrees"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"MaxTol", " ", "=", " ", 
   FractionBox[
    RowBox[{"RadNozzleFlange", " "}], 
    RowBox[{"Tan", "[", "MaxAng", "]"}]]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", 
  RowBox[{
  "\"\<MaxBeamDivergence: \>\"", ",", "MaxBeamDivergence", ",", 
   "\"\<\[Degree]\>\""}], "]"}], "\[IndentingNewLine]", 
