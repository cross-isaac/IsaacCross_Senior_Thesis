Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Define", " ", "parameters"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"nozzleRadius", "=", "0.1"}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{"Radius", " ", "at", " ", "the", " ", "nozzle"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"divergenceAngleDegrees", "=", "1.2"}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{
    "Beam", " ", "divergence", " ", "angle", " ", "in", " ", "degrees"}], 
    "*)"}], "\n", 
   RowBox[{
    RowBox[{"divergenceAngleRadians", "=", 
     RowBox[{"divergenceAngleDegrees", "*", 
      RowBox[{"Pi", "/", "180"}]}]}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{"Convert", " ", "to", " ", "radians"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"h", "=", "DisSamp"}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{
    "Distance", " ", "the", " ", "beam", " ", "travels", " ", "after", " ", 
     "the", " ", "nozzle"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"desiredPercentage", "=", "10"}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
     "Desired", " ", "percentage", " ", "of", " ", "overlap", " ", "length"}],
      ",", 
     RowBox[{"can", " ", "be", " ", "adjusted"}]}], "*)"}], 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
     "choose", " ", "10", "%", " ", "because", " ", "Rb", " ", "pressure", 
      " ", "ideally", " ", 
      SuperscriptBox["10", 
       RowBox[{"-", "6"}]]}], ",", " ", 
     RowBox[{
     "so", " ", "changing", " ", "by", " ", "order", " ", "of", " ", 
      "magnitude", " ", "of", " ", "two", " ", "requires", " ", "minimal", 
      " ", "increase", " ", "in", " ", "temperature"}], ",", " ", 
     RowBox[{
      RowBox[{"i", ".", "e", ".", " ", 
       SuperscriptBox["10", 
        RowBox[{"-", "3"}]]}], " ", "still", " ", "only", " ", "requires", 
      " ", "120", " ", "C"}], ",", " ", 
     RowBox[{
     "so", " ", "10", "%", " ", "is", " ", "completely", " ", "reasonable", 
      " ", "and", " ", "easy", " ", "to", " ", "deal", " ", "with"}]}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
     "keep", " ", "in", " ", "mind", " ", "this", " ", "length", " ", "is", 
      " ", "percent", " ", "is", " ", "greater", " ", "than", " ", "the", " ",
       "actual", " ", "percent", " ", "which", " ", "should", " ", "be", " ", 
      "area", " ", "of", " ", "overlap"}], ",", " ", 
     RowBox[{
     "but", " ", "from", " ", "above", " ", "statement", " ", "we", " ", 
      "can", " ", "deal", " ", "with", " ", "this", " ", "difference", " ", 
      "since", " ", 
      RowBox[{"won", "'"}], "t", " ", "be", " ", "order", " ", "of", " ", 
      "magnitude", " ", "difference"}], ",", " ", 
     RowBox[{
     "and", " ", "is", " ", "much", " ", "harder", " ", "to", " ", 
      "calculate", " ", "area", " ", "overlap"}]}], "*)"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Calculate", " ", "the", " ", "top", " ", "width", " ", "of", " ", "the", 
     " ", "truncated", " ", "cone"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"topWidthRed", "=", 
     RowBox[{"2", "*", 
      RowBox[{"(", 
       RowBox[{"nozzleRadius", "+", 
        RowBox[{"h", "*", 
         RowBox[{"Tan", "[", "divergenceAngleRadians", "]"}]}]}], ")"}]}]}], 
    ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Define", " ", "the", " ", "green", " ", 
     RowBox[{"cone", "'"}], "s", " ", "top", " ", "radius"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"greenConeTopRadius", "=", "0.2"}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{
    "Top", " ", "radius", " ", "for", " ", "the", " ", "green", " ", "cone"}],
     "*)"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Function", " ", "to", " ", "calculate", " ", "overlapping", " ", 
     "length", " ", "for", " ", "a", " ", "given", " ", "tilt", " ", 
     "angle"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"overlappingLengthFunction", "[", "tiltAngleDegrees_", "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "tiltAngleRadians", ",", "rotationMatrix", ",", "topLeftTilted", ",", 
         "topRightTilted", ",", "xIntersectionLeft", ",", 
         "xIntersectionRight", ",", "overlappingLength"}], "}"}], ",", 
       RowBox[{"(*", 
        RowBox[{
        "Convert", " ", "tilt", " ", "angle", " ", "to", " ", "radians"}], 
        "*)"}], "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"tiltAngleRadians", "=", 
         RowBox[{"tiltAngleDegrees", "*", 
          RowBox[{"Pi", "/", "180"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
         "Rotation", " ", "matrix", " ", "for", " ", "the", " ", "tilt"}], 
         "*)"}], "\[IndentingNewLine]", 
        RowBox[{"rotationMatrix", "=", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Cos", "[", "tiltAngleRadians", "]"}], ",", 
             RowBox[{"-", 
              RowBox[{"Sin", "[", "tiltAngleRadians", "]"}]}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Sin", "[", "tiltAngleRadians", "]"}], ",", 
             RowBox[{"Cos", "[", "tiltAngleRadians", "]"}]}], "}"}]}], 
          "}"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
         "Apply", " ", "rotation", " ", "to", " ", "the", " ", "top", " ", 
          "points", " ", "of", " ", "the", " ", "red", " ", "cone"}], "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"topLeftTilted", "=", 
         RowBox[{"rotationMatrix", ".", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{"-", "topWidthRed"}], "/", "2"}], ",", "h"}], "}"}]}]}], 
        ";", "\[IndentingNewLine]", 
        RowBox[{"topRightTilted", "=", 
         RowBox[{"rotationMatrix", ".", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"topWidthRed", "/", "2"}], ",", "h"}], "}"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
         "Calculate", " ", "the", " ", "intersection", " ", "points", " ", 
          "of", " ", "the", " ", "top", " ", "edges"}], "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"xIntersectionLeft", "=", 
         RowBox[{"Max", "[", 
          RowBox[{
           RowBox[{"-", "greenConeTopRadius"}], ",", 
           RowBox[{"Min", "[", 
            RowBox[{
             RowBox[{"topLeftTilted", "[", 
              RowBox[{"[", "1", "]"}], "]"}], ",", "greenConeTopRadius"}], 
            "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"xIntersectionRight", "=", 
         RowBox[{"Min", "[", 
          RowBox[{"greenConeTopRadius", ",", 
           RowBox[{"Max", "[", 
            RowBox[{
             RowBox[{"topRightTilted", "[", 
              RowBox[{"[", "1", "]"}], "]"}], ",", 
             RowBox[{"-", "greenConeTopRadius"}]}], "]"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
         "Ensure", " ", "the", " ", "intersection", " ", "points", " ", "are",
           " ", "within", " ", "the", " ", "bounds", " ", "of", " ", "the", 
          " ", "green", " ", 
          RowBox[{"cone", "'"}], "s", " ", "top", " ", "edge"}], "*)"}], 
        RowBox[{"xIntersectionLeft", "=", 
         RowBox[{"Max", "[", 
          RowBox[{"xIntersectionLeft", ",", 
           RowBox[{"-", "greenConeTopRadius"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"xIntersectionRight", "=", 
         RowBox[{"Min", "[", 
          RowBox[{"xIntersectionRight", ",", "greenConeTopRadius"}], "]"}]}], 
        ";", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
         "Calculate", " ", "the", " ", "length", " ", "of", " ", "the", " ", 
          "overlapping", " ", "region"}], "*)"}], "\[IndentingNewLine]", 
        RowBox[{"overlappingLength", "=", 
         RowBox[{"Max", "[", 
          RowBox[{"0", ",", 
           RowBox[{"xIntersectionRight", "-", "xIntersectionLeft"}]}], 
          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"Return", " ", "the", " ", "overlapping", " ", "length"}], 
         "*)"}], "\[IndentingNewLine]", "overlappingLength"}]}], "]"}]}], 
    ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Function", " ", "to", " ", "find", " ", "the", " ", "maximum", " ", 
     "tilt", " ", "angle", " ", "for", " ", "a", " ", "given", " ", 
     "percentage", " ", "of", " ", "overlap"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"findMaxTiltAngle", "[", "percentage_", "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"tiltAngleDegrees", ",", "overlapLength", ",", "equation"}], 
        "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "Define", " ", "the", " ", "equation", " ", "for", " ", "the", " ", 
         "desired", " ", "overlap", " ", "percentage"}], "*)"}], 
       RowBox[{
        RowBox[{"equation", "=", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{
             "overlappingLengthFunction", "[", "tiltAngleDegrees", "]"}], "/", 
             RowBox[{"(", 
              RowBox[{"2", "*", "greenConeTopRadius"}], ")"}]}], ")"}], "*", 
           "100"}], "==", "percentage"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
         "Find", " ", "the", " ", "root", " ", "of", " ", "the", " ", 
          "equation", " ", "for", " ", "the", " ", "tilt", " ", "angle"}], 
         "*)"}], 
        RowBox[{"tiltAngleDegrees", "/.", " ", 
         RowBox[{"FindRoot", "[", 
          RowBox[{"equation", ",", 
           RowBox[{"{", 
            RowBox[{"tiltAngleDegrees", ",", "0.1", ",", "5"}], "}"}], ",", 
           RowBox[{"AccuracyGoal", "->", "6"}], ",", 
           RowBox[{"PrecisionGoal", "->", "6"}]}], "]"}]}]}]}], "]"}]}], 
    ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Find", " ", "the", " ", "maximum", " ", "tilt", " ", "angle", " ", "for",
      " ", "the", " ", "desired", " ", "percentage", " ", "of", " ", 
     "overlap"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"maxTiltAngle", "=", 
     RowBox[{"findMaxTiltAngle", "[", "desiredPercentage", "]"}]}], ";"}], 
   "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Print", " ", "the", " ", "maximum", " ", "tilt", " ", "angle"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
