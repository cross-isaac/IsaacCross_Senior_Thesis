   RowBox[{
    RowBox[{"MaxTiltHeight", "=", " ", 
     RowBox[{
      FractionBox["1", "2"], "*", "10", "*", 
      FractionBox["5", "1000"]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"NozzleFlangeRadius", " ", "=", " ", 
     RowBox[{"1.33", "/", "2"}]}], ";"}], "\[IndentingNewLine]", 
