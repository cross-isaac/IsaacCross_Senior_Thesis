Cell[CellGroupData[{

Cell[TextData[StyleBox["MicroCapilarry Array Tilt to avoid tolerance issues", \
"Subsection"]], "Subsubsection",
 InitializationCell->True,
 CellChangeTimes->{{3.927801373159797*^9, 3.9278013759267473`*^9}, {
  3.9278041880386863`*^9, 3.9278042037088723`*^9}, {3.9279062534998384`*^9, 
  3.9279062590601034`*^9}},ExpressionUUID->"3dbdf97d-df50-466f-9092-\
b3af55e5c3f2"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Define", " ", "parameters"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"nozzleRadius", "=", 
     RowBox[{"0.1", "/", "2"}]}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{"Radius", " ", "at", " ", "the", " ", "nozzle"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"divergenceAngleDegrees", "=", "1"}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{
    "Beam", " ", "divergence", " ", "angle", " ", "in", " ", "degrees"}], 
    "*)"}], "\n", 
   RowBox[{
    RowBox[{"divergenceAngleRadians", "=", 
     RowBox[{"divergenceAngleDegrees", "*", 
      RowBox[{"Pi", "/", "180"}]}]}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{"Convert", " ", "to", " ", "radians"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"h", "=", "10.5"}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{
    "Distance", " ", "the", " ", "beam", " ", "travels", " ", "after", " ", 
     "the", " ", "nozzle"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"tiltAngleDegrees", "=", "\[InvisibleSpace]", "0"}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Tilt", " ", "angle", " ", "in", " ", "degrees"}], ",", 
     RowBox[{"can", " ", "be", " ", "changed"}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"tiltAngleRadians", "=", 
     RowBox[{"tiltAngleDegrees", "*", 
      RowBox[{"Pi", "/", "180"}]}]}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{"Convert", " ", "to", " ", "radians"}], "*)"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Calculate", " ", "the", " ", "top", " ", "width", " ", "of", " ", "the", 
     " ", "truncated", " ", "triangle", " ", "for", " ", "the", " ", "red", 
     " ", "cone"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"topWidthRed", "=", 
     RowBox[{"2", "*", 
      RowBox[{"(", 
       RowBox[{"nozzleRadius", "+", 
        RowBox[{"h", "*", 
         RowBox[{"Tan", "[", "divergenceAngleRadians", "]"}]}]}], ")"}]}]}], 
    ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Coordinates", " ", "for", " ", "the", " ", "original", " ", "truncated", 
     " ", "triangle", " ", "for", " ", "the", " ", "red", " ", "cone"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"bottomLeft", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "nozzleRadius"}], ",", "0"}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"bottomRight", "=", 
     RowBox[{"{", 
      RowBox[{"nozzleRadius", ",", "0"}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"topLeftRed", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"-", "topWidthRed"}], "/", "2"}], ",", "h"}], "}"}]}], ";"}], 
   "\n", 
   RowBox[{
    RowBox[{"topRightRed", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"topWidthRed", "/", "2"}], ",", "h"}], "}"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Rotation", " ", "matrix", " ", "for", " ", "the", " ", "tilt"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"rotationMatrix", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Cos", "[", "tiltAngleRadians", "]"}], ",", 
         RowBox[{"-", 
          RowBox[{"Sin", "[", "tiltAngleRadians", "]"}]}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Sin", "[", "tiltAngleRadians", "]"}], ",", 
         RowBox[{"Cos", "[", "tiltAngleRadians", "]"}]}], "}"}]}], "}"}]}], 
    ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Apply", " ", "rotation", " ", "to", " ", "the", " ", "top", " ", 
     "points", " ", "of", " ", "the", " ", "red", " ", "cone"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"topLeftTilted", "=", 
     RowBox[{"rotationMatrix", ".", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"topLeftRed", "[", 
         RowBox[{"[", "1", "]"}], "]"}], ",", 
        RowBox[{"topLeftRed", "[", 
         RowBox[{"[", "2", "]"}], "]"}]}], "}"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"topRightTilted", "=", 
     RowBox[{"rotationMatrix", ".", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"topRightRed", "[", 
         RowBox[{"[", "1", "]"}], "]"}], ",", 
        RowBox[{"topRightRed", "[", 
         RowBox[{"[", "2", "]"}], "]"}]}], "}"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
     "Top", " ", "radius", " ", "of", " ", "the", " ", "green", " ", "cone"}],
      ",", " ", 
     RowBox[{
     "based", " ", "on", " ", "smallest", " ", "ID", " ", "we", " ", "pass", 
      " ", "through"}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"greenConeTopRadius", "=", "0.2"}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Coordinates", " ", "for", " ", "the", " ", "green", " ", "cone"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"greenTopLeft", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "greenConeTopRadius"}], ",", "h"}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"greenTopRight", "=", 
     RowBox[{"{", 
      RowBox[{"greenConeTopRadius", ",", "h"}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Function", " ", "to", " ", "calculate", " ", "overlapping", " ", 
     "length", " ", "for", " ", "a", " ", "given", " ", "tilt", " ", 
     "angle"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"overlappingLengthFunction", "[", "tiltAngleDegrees_", "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "tiltAngleRadians", ",", "topLeftTilted", ",", "topRightTilted", ",", 
         "xIntersectionLeft", ",", "xIntersectionRight", ",", 
         "overlappingLength"}], "}"}], ",", 
       RowBox[{"(*", 
        RowBox[{
        "Convert", " ", "tilt", " ", "angle", " ", "to", " ", "radians"}], 
        "*)"}], 
       RowBox[{
        RowBox[{"tiltAngleRadians", "=", 
         RowBox[{"tiltAngleDegrees", "*", 
          RowBox[{"Pi", "/", "180"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
         "Rotation", " ", "matrix", " ", "for", " ", "the", " ", "tilt"}], 
         "*)"}], "\[IndentingNewLine]", 
        RowBox[{"rotationMatrix", "=", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Cos", "[", "tiltAngleRadians", "]"}], ",", 
             RowBox[{"-", 
              RowBox[{"Sin", "[", "tiltAngleRadians", "]"}]}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Sin", "[", "tiltAngleRadians", "]"}], ",", 
             RowBox[{"Cos", "[", "tiltAngleRadians", "]"}]}], "}"}]}], 
          "}"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
         "Apply", " ", "rotation", " ", "to", " ", "the", " ", "top", " ", 
          "points", " ", "of", " ", "the", " ", "red", " ", "cone"}], "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"topLeftTilted", "=", 
         RowBox[{"rotationMatrix", ".", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"topLeftRed", "[", 
             RowBox[{"[", "1", "]"}], "]"}], ",", 
            RowBox[{"topLeftRed", "[", 
             RowBox[{"[", "2", "]"}], "]"}]}], "}"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"topRightTilted", "=", 
         RowBox[{"rotationMatrix", ".", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"topRightRed", "[", 
             RowBox[{"[", "1", "]"}], "]"}], ",", 
            RowBox[{"topRightRed", "[", 
             RowBox[{"[", "2", "]"}], "]"}]}], "}"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
         "Calculate", " ", "the", " ", "intersection", " ", "points", " ", 
          "of", " ", "the", " ", "top", " ", "edges"}], "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"xIntersectionLeft", "=", 
         RowBox[{"Max", "[", 
          RowBox[{
           RowBox[{"-", "greenConeTopRadius"}], ",", 
           RowBox[{"Min", "[", 
            RowBox[{
             RowBox[{"topLeftTilted", "[", 
              RowBox[{"[", "1", "]"}], "]"}], ",", 
             RowBox[{"topRightTilted", "[", 
              RowBox[{"[", "1", "]"}], "]"}]}], "]"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"xIntersectionRight", "=", 
         RowBox[{"Min", "[", 
          RowBox[{"greenConeTopRadius", ",", 
           RowBox[{"Max", "[", 
            RowBox[{
             RowBox[{"topLeftTilted", "[", 
              RowBox[{"[", "1", "]"}], "]"}], ",", 
             RowBox[{"topRightTilted", "[", 
              RowBox[{"[", "1", "]"}], "]"}]}], "]"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
         "Ensure", " ", "the", " ", "intersection", " ", "points", " ", "are",
           " ", "within", " ", "the", " ", "bounds", " ", "of", " ", "the", 
          " ", "green", " ", 
          RowBox[{"cone", "'"}], "s", " ", "top", " ", "edge"}], "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"xIntersectionLeft", "=", 
         RowBox[{"Max", "[", 
          RowBox[{"xIntersectionLeft", ",", 
           RowBox[{"-", "greenConeTopRadius"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"xIntersectionRight", "=", 
         RowBox[{"Min", "[", 
          RowBox[{"xIntersectionRight", ",", "greenConeTopRadius"}], "]"}]}], 
        ";", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
         "Calculate", " ", "the", " ", "length", " ", "of", " ", "the", " ", 
          "overlapping", " ", "region"}], "*)"}], 
        RowBox[{"overlappingLength", "=", 
         RowBox[{"Max", "[", 
          RowBox[{"0", ",", 
           RowBox[{"xIntersectionRight", "-", "xIntersectionLeft"}]}], 
          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"Return", " ", "the", " ", "overlapping", " ", "length"}], 
         "*)"}], 
        RowBox[{"{", 
         RowBox[{
         "overlappingLength", ",", "xIntersectionLeft", ",", 
          "xIntersectionRight"}], "}"}]}]}], "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Calculate", " ", "the", " ", "overlapping", " ", "length", " ", "for", 
     " ", "the", " ", "given", " ", "tilt", " ", "angle"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"overlappingLength", "=", 
     RowBox[{
      RowBox[{"overlappingLengthFunction", "[", "tiltAngleDegrees", "]"}], 
      "[", 
      RowBox[{"[", "1", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Length", " ", "of", " ", "the", " ", "top", " ", "edge", " ", "of", " ", 
     "the", " ", "green", " ", "cone"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"greenTopLength", "=", 
     RowBox[{"2", "*", "greenConeTopRadius"}]}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"This", " ", "is", " ", "the", " ", "full", " ", "diameter"}], 
     ",", 
     RowBox[{"which", " ", "is", " ", "twice", " ", "the", " ", "radius"}]}], 
    "*)"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Calculate", " ", "the", " ", "percentage", " ", "of", " ", "overlap", 
     " ", "relative", " ", "to", " ", "the", " ", "green", " ", "top", " ", 
     "edge", " ", "length"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"percentageOverlapLength", "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"overlappingLength", "/", "greenTopLength"}], ")"}], "*", 
      "100"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Calculate", " ", "the", " ", "percentage", " ", "of", " ", "Rb", " ", 
     "lost", " ", "to", " ", "walls"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"percentageRbLost", " ", "=", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"topWidthRed", " ", "-", " ", "overlappingLength"}], ")"}], 
        "/", "topWidthRed"}], ")"}], "*", "100"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Print", " ", "results"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{
     "\"\<Tilt angle: \>\"", ",", "tiltAngleDegrees", ",", 
      "\"\< degrees\>\""}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{
     "\"\<Length of the overlapping region at y = h: \>\"", ",", 
      "overlappingLength", ",", "\"\< in\>\""}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{
     "\"\<Length of the top edge of the green cone: \>\"", ",", 
      "greenTopLength", ",", "\"\< in\>\""}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{
     "\"\<Percentage of overlap length relative to the green top edge: \>\"", 
      ",", "percentageOverlapLength", ",", "\"\< %\>\""}], "]"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{
     "\"\<Percentage of Rb lost to walls: \>\"", ",", "percentageRbLost", 
      ",", "\"\< %\>\""}], "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", 
     "\"\<Rememeber this is a 1D simplifcation of a 3D system\>\"", "]"}], 
    ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", "Visualization", "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Define", " ", "the", " ", "green", " ", "cone", " ", "polygon"}],
     "*)"}], "\n", 
   RowBox[{
    RowBox[{"greenCone", "=", 
     RowBox[{"Graphics", "[", 
      RowBox[{"{", 
       RowBox[{"Green", ",", 
        RowBox[{"Opacity", "[", "0.6", "]"}], ",", 
        RowBox[{"Polygon", "[", 
         RowBox[{"{", 
          RowBox[{
          "bottomLeft", ",", "bottomRight", ",", "greenTopRight", ",", 
           "greenTopLeft"}], "}"}], "]"}]}], "}"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Define", " ", "the", " ", "tilted", " ", "red", " ", "cone", " ", 
     "polygon"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"tiltedTriangle", "=", 
     RowBox[{"Graphics", "[", 
      RowBox[{"{", 
       RowBox[{"Red", ",", 
        RowBox[{"Opacity", "[", "0.6", "]"}], ",", 
        RowBox[{"Polygon", "[", 
         RowBox[{"{", 
          RowBox[{
          "bottomLeft", ",", "bottomRight", ",", "topRightTilted", ",", 
           "topLeftTilted"}], "}"}], "]"}]}], "}"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Calculate", " ", "correct", " ", "intersection", " ", "points"}],
     "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"xIntersectionLeftPlot", "=", 
     RowBox[{
      RowBox[{"overlappingLengthFunction", "[", "tiltAngleDegrees", "]"}], 
      "[", 
      RowBox[{"[", "2", "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"xIntersectionRightPlot", "=", 
     RowBox[{
      RowBox[{"overlappingLengthFunction", "[", "tiltAngleDegrees", "]"}], 
      "[", 
      RowBox[{"[", "3", "]"}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Plot", " ", "the", " ", "intersection", " ", "points"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"intersectionPoints", "=", 
     RowBox[{"Graphics", "[", 
      RowBox[{"{", 
       RowBox[{"Black", ",", 
        RowBox[{"PointSize", "[", "Large", "]"}], ",", 
        RowBox[{"Point", "[", 
         RowBox[{"{", 
          RowBox[{"xIntersectionLeftPlot", ",", "h"}], "}"}], "]"}], ",", 
        RowBox[{"Point", "[", 
         RowBox[{"{", 
          RowBox[{"xIntersectionRightPlot", ",", "h"}], "}"}], "]"}]}], "}"}],
       "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Display", " ", "the", " ", "plots", " ", "for", " ", "comparison"}], 
    "*)"}], "\n", 
   RowBox[{"Show", "[", 
    RowBox[{
    "tiltedTriangle", ",", "greenCone", ",", "intersectionPoints", ",", 
     RowBox[{"Axes", "->", "True"}], ",", 
     RowBox[{"AxesOrigin", "->", 
      RowBox[{"{", 
       RowBox[{"0", ",", "0"}], "}"}]}], ",", 
     RowBox[{"PlotRange", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "0.5"}], ",", "0.5"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", 
          RowBox[{"h", "+", "1"}]}], "}"}]}], "}"}]}], ",", 
     RowBox[{"AxesLabel", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<x\>\"", ",", "\"\<y\>\""}], "}"}]}], ",", 
     RowBox[{
     "PlotLabel", "->", 
      "\"\<Tilted Red Cone, Green Cone, and Intersection Points\>\""}], ",", 
     RowBox[{"Ticks", "->", "Automatic"}], ",", 
     RowBox[{"AspectRatio", "->", "1"}], ",", 
     RowBox[{"ImageSize", "->", "400"}]}], "]"}]}]}]], "Input",
